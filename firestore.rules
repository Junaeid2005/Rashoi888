rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email == 'bluepeakzone2005@gmail.com')
      );
    }

    function isDateBlocked(dateStr) {
      return exists(/databases/$(database)/documents/fullyBookedDates/$(dateStr)) &&
             get(/databases/$(database)/documents/fullyBookedDates/$(dateStr)).data.isFullyBooked == true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow write: if isAdmin();
    }

    // Restaurant Settings
    match /restaurantSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Menu Categories
    match /menuCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Menu Items
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Classic Dishes Pricing Matrix
    match /classicDishesPricing/{dishId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fully Booked Dates
    match /fullyBookedDates/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Booked Time Slots (Zero PII - prevents double bookings on same time)
    match /bookedSlots/{dateId} {
      allow read, write: if true;
    }

    // Customer Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gallery
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Messages & Feedback
    match /customerMessages/{messageId} {
      allow create: if isValidId(messageId) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
        request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 150 &&
        request.resource.data.subject is string && request.resource.data.subject.size() <= 200 &&
        request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 3000 &&
        request.resource.data.category in ['Complaint', 'Feedback', 'Menu Suggestion', 'General Enquiry', 'Other'];
      allow read, update, delete: if isAdmin();
    }

    // Table Reservations
    match /reservations/{reservationId} {
      allow create: if isValidId(reservationId) &&
        !isDateBlocked(request.resource.data.date) &&
        request.resource.data.customerName is string && request.resource.data.customerName.size() > 0 && request.resource.data.customerName.size() <= 100 &&
        request.resource.data.customerEmail is string && request.resource.data.customerEmail.size() > 0 && request.resource.data.customerEmail.size() <= 150 &&
        request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() > 0 && request.resource.data.customerPhone.size() <= 30 &&
        request.resource.data.date is string && request.resource.data.date.size() == 10 &&
        request.resource.data.time is string && request.resource.data.time.size() <= 20 &&
        request.resource.data.guests is number && request.resource.data.guests >= 1 && request.resource.data.guests <= 50 &&
        request.resource.data.status == 'pending';
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.get('customerId', '') == request.auth.uid ||
        (request.auth.token.email != null && resource.data.get('customerEmail', '') == request.auth.token.email)
      ));
      allow update: if isAdmin() || (isSignedIn() && (
        resource.data.get('customerId', '') == request.auth.uid ||
        (request.auth.token.email != null && resource.data.get('customerEmail', '') == request.auth.token.email)
      ) && request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // Takeaway Orders
    match /orders/{orderId} {
      allow create: if isValidId(orderId) &&
        request.resource.data.customerName is string && request.resource.data.customerName.size() > 0 &&
        request.resource.data.customerEmail is string && request.resource.data.customerEmail.size() > 0 &&
        request.resource.data.totalAmount is number && request.resource.data.totalAmount >= 0 &&
        request.resource.data.orderStatus == 'new' &&
        (request.resource.data.paymentStatus == 'unpaid' || request.resource.data.paymentStatus == 'pending');
      allow read: if isAdmin() || (isSignedIn() && (
        resource.data.get('customerId', '') == request.auth.uid ||
        (request.auth.token.email != null && resource.data.get('customerEmail', '') == request.auth.token.email)
      ));
      allow update: if isAdmin() || (isSignedIn() && (
        resource.data.get('customerId', '') == request.auth.uid ||
        (request.auth.token.email != null && resource.data.get('customerEmail', '') == request.auth.token.email)
      ));
      allow delete: if isAdmin();
    }
  }
}
